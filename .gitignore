__pycache__/
.pytest_cache/
*.egg-info/
.venv/
data/raw/*
data/processed/*
adapters/*
results/**/*.json
results/**/*.csv


# ============================================================
# Generated experiment outputs
# ============================================================
results/raw/*
results/aggregate/*
results/figures/*

# Keep result directory structure in Git
!results/raw/.gitkeep
!results/aggregate/.gitkeep
!results/figures/.gitkeep

# M6 prepared real workloads and their manifests
results/workloads/*
results/manifests/*
!results/workloads/.gitkeep
!results/manifests/.gitkeep

# Offline CacheGen tensor interchange and opaque codec payloads
results/cachegen/**/*.pt
results/cachegen/**/*.bin

# Versioned C1.5-B source audit and design (not experimental measurements)
!results/cachegen/c1_5b/source_audit.json
!results/cachegen/c1_5b/design_manifest.json

# C1.5C source/configuration only; generated smoke and parity measurements stay ignored.
!results/cachegen/c1_5c/design_manifest.json
